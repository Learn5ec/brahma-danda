# Copy to `.env` and fill in. This file holds NON-SECRET config only.
# Secrets go in ./secrets/*.txt (see README), never here.

# Slack channel ID to post the report to (not the channel name — the ID, e.g. C0123ABCXYZ)
SLACK_CHANNEL_ID=C0123ABCXYZ

# Claude model used for the remediation-plan step
CLAUDE_MODEL=claude-sonnet-5

# Custom Anthropic-compatible gateway (optional — leave blank for default Anthropic cloud API).
# When set, ANTHROPIC_AUTH_TOKEN is used as the API key (overrides /run/secrets/claude_api_key).
# The Anthropic SDK's base_url parameter routes calls to this endpoint.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Override model when using a custom gateway (takes precedence over CLAUDE_MODEL).
ANTHROPIC_MODEL=ornith-1.0

# ── Local Ollama support (fallback) ──
# Use a local Ollama instance as fallback if Claude API is unavailable.
# Claude API is the primary backend; Ollama is the fallback.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-coder-v2:16b

# When to run, in standard cron syntax (default: 03:00 on the 1st of every month)
SCAN_SCHEDULE_CRON=0 3 1 * *

# Optional: override the hostname shown in the Slack report
# (useful if the container hostname isn't meaningful, e.g. in orchestrated environments)
HOSTNAME_OVERRIDE=

# ── nmap self-scan ──
# Scans THIS host's real open ports (needs network_mode: host — see README).
# Set to false to disable nmap entirely and drop that networking requirement.
NMAP_SELF_SCAN=true

# Safe by default: detection scripts only, nothing that attacks the host.
# Categories available: default,discovery,safe,vuln,auth,broadcast,version
# DELIBERATELY EXCLUDED unless you opt in below: dos, exploit, brute, fuzzer
NMAP_SCRIPT_CATEGORIES=default,discovery,safe,vuln,auth

# Set to true only if you have a maintenance window and accept that this WILL
# actively exploit/DoS/brute-force services on THIS host. See README first.
NMAP_ALLOW_INTRUSIVE=false
